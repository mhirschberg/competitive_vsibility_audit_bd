{
  "hosting": {
    "site": "qaviso-web-21729",
    "public": "web/home-dist",
    "ignore": ["firebase.home.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/qaviso-home.html"
      }
    ]
  }
}
