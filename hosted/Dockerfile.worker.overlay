# Emergency release path when PyPI is unavailable. The pinned base is the
# already deployed 2abce23 worker; keep the lightweight runner builder and
# worker entry point together when overlaying this branch's notebook runtime.
FROM europe-west1-docker.pkg.dev/getmuzoboz/competitive-audit/worker@sha256:2454437f01edfdb32b55eb6073443297b36c3d642e7f61a04e57587251a6af82

COPY competitive_visibility_audit_bd.ipynb /app/competitive_visibility_audit_bd.ipynb
COPY reddit_social.py /app/reddit_social.py
COPY runner_builder.py /app/runner_builder.py
COPY hosted/worker.py /app/hosted/worker.py
COPY audit_core /app/audit_core
COPY scripts/run_local_audit.py /app/scripts/run_local_audit.py
RUN python -c 'from runner_builder import _build_runner_script; a=("Acme", "example.com", "widgets", "US", "auto", False, False); compile(_build_runner_script(*a), "<runner>", "exec"); compile(_build_runner_script(*a, True), "<long-runner>", "exec")'
